# ── Line endings ─────────────────────────────────────────────
# Normalise all text files to LF on commit
* text=auto eol=lf

# Force LF for shell scripts (must not have CRLF)
*.sh text eol=lf
*.bash text eol=lf

# Force LF for Rust source
*.rs text eol=lf

# Force LF for JavaScript / TypeScript
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf

# Force LF for config / markup
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.cff text eol=lf
*.css text eol=lf
*.html text eol=lf

# ── Binary files — no diffing or merging ──────────────────────
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.wasm binary
*.mp4 binary
*.pdf binary
*.xlsx binary
*.zip binary

# ── Diff drivers ─────────────────────────────────────────────
# Treat Rust files as Rust for diffs
*.rs diff=rust

# Treat lock files as generated — suppress in PR diffs
Cargo.lock linguist-generated=true
package-lock.json linguist-generated=true

# Mark WASM build output as generated
contracts/target/** linguist-generated=true
frontend/dist/** linguist-generated=true
