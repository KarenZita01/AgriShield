# ─────────────────────────────────────────────────────────────
# AgriShield Frontend — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# All VITE_* variables are inlined at build time.
# Changing them after a build has no effect — you must rebuild.
# ─────────────────────────────────────────────────────────────

# ── Stellar Network ──────────────────────────────────────────
# Soroban RPC endpoint
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (testnet default shown)
VITE_NETWORK_PASSPHRASE=Test SDF Future Network ; October 2022

# Horizon REST API (used for account balances)
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# ── Contract Addresses ───────────────────────────────────────
# Insurance Pool contract ID (required — app shows empty state without this)
VITE_POOL_CONTRACT_ID=

# MicroUSD token contract ID (required for balance reads)
VITE_TOKEN_CONTRACT_ID=

# ── Analytics (optional) ─────────────────────────────────────
# PostHog project API key — leave blank to disable analytics
VITE_POSTHOG_KEY=

# ── Error Monitoring (optional) ──────────────────────────────
# Sentry DSN — leave blank to disable error reporting
VITE_SENTRY_DSN=
